#: data/file-share-properties.ui:38
msgid "_Close"
msgstr "Жа_бу"

#: data/file-share-properties.ui:54
msgid "_Help"
msgstr "Көм_ек"

#: data/file-share-properties.ui:94
msgid "<b>Share Files over the Network</b>"
msgstr "<b>Файлдарды желі арқылы ортақ пайдалану</b>"

#: data/file-share-properties.ui:140
msgid "_Share public files on network"
msgstr "Желідегі жария файлдарды ортақ па_йдалану"

#: data/file-share-properties.ui:157
msgid "_Password:"
msgstr "_Пароль:"

#: data/file-share-properties.ui:171
msgid "_Require password:"
msgstr "Парольді _талап ету:"

#: data/file-share-properties.ui:206
msgid "<b>Share Files over Bluetooth</b>"
msgstr "<b>Файлдарды Bluetooth арқылы ортақ пайдалану</b>"

#: data/file-share-properties.ui:229
msgid "Share public files over _Bluetooth"
msgstr "Жария файлдарды _Bluetooth арқылы ортақ пайдалану"

#: data/file-share-properties.ui:244
msgid "Allo_w remote devices to delete files"
msgstr "Қашықтағы құрылғыларға файлдарды өшіруге рұқсат _ету"

#: data/file-share-properties.ui:259
msgid "Require re_mote devices to bond with this computer"
msgstr "Қашықтағы құрылғылардан осы компьютермен жұп_тасуды талап ету"

#: data/file-share-properties.ui:297
msgid "<b>Receive Files over Bluetooth</b>"
msgstr "<b>Bluetooth арқылы файлдарды қабылдау</b>"

#: data/file-share-properties.ui:320
msgid "Receive files in _Downloads folder over Bluetooth"
msgstr "Bluetooth арқылы «_Жүктемелер» бумасына файлдарды қабылдау"

#: data/file-share-properties.ui:348
msgid "_Accept files: "
msgstr "Файлдарды қ_абылдау: "

#: data/file-share-properties.ui:360
msgid "_Notify about received files"
msgstr "Қабылданған файлдар туралы _хабарлау"

#: data/libcaja-user-share.desktop.in.in:5
msgid "User Share"
msgstr "Пайдаланушылық бөлісу"

#: data/libcaja-user-share.desktop.in.in:6
msgid "Integrates with user-share"
msgstr "user-share жүйесімен интеграцияланады"

#: data/mate-user-share-properties.desktop.in:3 src/caja-share-bar.c:100
msgid "Personal File Sharing"
msgstr "Жеке файлдармен бөлісу"

#: data/mate-user-share-properties.desktop.in:4
msgid "Preferences for sharing of files"
msgstr "Файлдарды ортақ пайдалану баптаулары"

