msgid "share;files;bluetooth;obex;http;network;copy;send;"
msgstr "ортақ пайдалану;файлдар;bluetooth;obex;http;желі;көшіру;жіберу;"

#: data/mate-user-share-obexpush.desktop.in.in:3
